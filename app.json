{
  "expo": {
    "name": "Mon lecteur de Coran",
    "slug": "mon-lecteur-de-coran",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "monlecteurdecoran",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FDFBF4",
    "ios": {
      "bundleIdentifier": "com.monlecteurdecoran.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.monlecteurdecoran.app",
      "adaptiveIcon": {
        "backgroundColor": "#FDFBF4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDFBF4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
